# docker-compose bu dosyayı .env olarak okur:  cp .env.example .env
POSTGRES_PASSWORD=sila_secret
# Yönetici şifresi: gider/duyuru ekleme-düzenleme ve öneri durumu değiştirme için
ADMIN_TOKEN=sila-yonetici
# Vercel adresinizi yazın (virgülle birden fazla): https://sila-apartmani.vercel.app
CORS_ORIGIN=*
# "Daire başına düşen" hesabı için toplam daire sayısı
UNIT_COUNT=12
